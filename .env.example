# Entity Project - Environment Variables
# Copy to .env and customize

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql+asyncpg://entity:entity@localhost:5432/entity
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# ============================================
# MODEL CONFIGURATION
# ============================================
MODEL_VOCAB_SIZE=32000
MODEL_D_MODEL=512
MODEL_N_LAYERS=8
MODEL_N_HEADS=8
MODEL_N_KV_HEADS=4
MODEL_D_FF=2048
MODEL_MAX_SEQ_LEN=2048
MODEL_ROPE_THETA=10000.0
MODEL_ROPE_SCALING=null
MODEL_DROPOUT=0.1
MODEL_TIE_EMBEDDINGS=true
MODEL_USE_FLASH_ATTN=false

# ============================================
# TRAINING
# ============================================
TRAINING_BATCH_SIZE=32
TRAINING_GRAD_ACCUM_STEPS=4
TRAINING_LEARNING_RATE=3e-4
TRAINING_MIN_LR=3e-5
TRAINING_WEIGHT_DECAY=0.1
TRAINING_MAX_STEPS=100000
TRAINING_WARMUP_STEPS=1000
TRAINING_MAX_GRAD_NORM=1.0
TRAINING_EVAL_INTERVAL=500
TRAINING_SAVE_INTERVAL=1000
TRAINING_LOG_INTERVAL=10
TRAINING_MIXED_PRECISION=true
TRAINING_GRADIENT_CHECKPOINTING=false
TRAINING_DEVICE=auto

# ============================================
# PATHS
# ============================================
SNAPSHOT_ROOT=/data/snapshots
DATASET_ROOT=/data/datasets
CHECKPOINT_ROOT=/data/checkpoints
LOG_ROOT=/data/logs

# ============================================
# CONTAINMENT & SAFETY
# ============================================
CONTAINMENT_STRICT_MODE=true
KILL_SWITCH_AUTO_TERMINATE_ON_CRITICAL=false
CONTAINMENT_LOG_LEVEL=warning

# Allowed domains for web research (comma-separated)
ALLOWED_RESEARCH_DOMAINS=wikipedia.org,github.com,arxiv.org,stackoverflow.com,medium.com,blog.google.com,openai.com,anthropic.com

# ============================================
# RESEARCH
# ============================================
RESEARCH_RATE_LIMIT=10
RESEARCH_TIMEOUT=30
RESEARCH_MAX_DEPTH=3
RESEARCH_MAX_BREADTH=5
RESEARCH_USER_AGENT=Entity/1.0 (Community Digital Entity; +https://entity.example.com)

# ============================================
# CONSOLIDATION (SLEEP)
# ============================================
CONSOLIDATION_INTERVAL_HOURS=6
CONSOLIDATION_MIN_MEMORIES=50
CONSOLIDATION_MAX_MEMORIES=500
CONSOLIDATION_SIMILARITY_THRESHOLD=0.75

# ============================================
# REFLECTION
# ============================================
REFLECTION_INTERVAL_HOURS=12
REFLECTION_MAX_MEMORIES=20
REFLECTION_CONTRADICTION_THRESHOLD=0.7

# ============================================
# EVOLUTION
# ============================================
PROMOTION_SAFETY_THRESHOLD=0.95
PROMOTION_IMPROVEMENT_THRESHOLD=0.05
PROMOTION_MIN_STEPS=10000

# ============================================
# WEB FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================
# MONITORING
# ============================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
OTEL_EXPORTER_PROMETHEUS_ENABLED=true