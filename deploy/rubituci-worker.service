[Unit]
Description=Rubituci AI Sleep Worker
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=rubituci
Group=rubituci
WorkingDirectory=/opt/rubituci-ai/current
EnvironmentFile=/opt/rubituci-ai/shared/.env
EnvironmentFile=/opt/rubituci-ai/shared/.env.production
EnvironmentFile=/opt/rubituci-ai/shared/.env.secret
ExecStart=/opt/rubituci-ai/venv/bin/celery -A worker.celery_app worker --beat --loglevel=info --concurrency=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
